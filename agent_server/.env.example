# API 키 설정 파일의 견본입니다. (이 파일에는 진짜 키를 넣지 마세요)
# 사용법: 같은 폴더에 ".env" 라는 이름으로 복사한 뒤 아래 값을 채우세요.
#   copy agent_server\.env.example agent_server\.env
# 제출할 때는 이 .env 를 압축 파일의 맨 위 폴더(start_server.sh 가 있는 곳)에 넣습니다. (agent_server/.env 도 그대로 읽힙니다)
# 주의: ".env" 는 절대 깃에 올리거나 공유하지 마세요. (.gitignore 로 막아 두었어요)

# ── 방법 1 (대회 현장): BAZE API Gateway 키 하나로 받아쓰기·생각·말하기를 모두 부릅니다 ──
BAZE_API_KEY=

# ── 방법 2: 서비스를 직접 부릅니다 (위 BAZE_API_KEY 가 비어 있을 때만 사용) ──
OPENAI_API_KEY=
SONIOX_API_KEY=
GEMINI_API_KEY=

# ── 아래는 선택 사항입니다 (필요할 때만 앞의 # 을 지우고 쓰세요) ──
# BAZE_BASE_URL=https://api.baze.co/v1/gateway
# SONIOX_MODEL=stt-rt-v6
# LLM_EFFORT=low
# TTS_MODEL=gemini-3.8-flash-tts
# END_SILENCE_MS=800
# LONG_SILENCE_MS=1800
# TYPESAFE_API_KEY=      # Jev 키. 넣으면 말 끝 판정·업무 분류가 바로 켜진다 (JEV_HANDOFF.md). 제출용 .env 에는 넣지 말 것
# EOT_MODE=auto          # Jev 말 끝 판정: auto(TYPESAFE 키가 있을 때만) / jev(BAZE 게이트웨이로도) / live / off
# CASE_ROUTER=auto       # Jev 업무 분류: 값은 위와 같다
# CASE_PROMPT=add        # 분류된 업무 지침을 프롬프트에 더함 (off 면 더하지 않음)
# PACE_ADAPT=live        # 말이 느린 사람 대기 늘리기: off / live(시험기·시연만) / all  (pace.md)
# PACE_REF_CPS=5.3
# TTS_STREAM=1
# TTS_PER_SENTENCE=0
# TTS_VOICE=Kore
# TTS_STYLE="Say: "
# VERBOSE=1
